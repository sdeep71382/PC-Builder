// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Builder {
  id          String   @id @default(cuid())
  publicId    String?  @unique
  shopId      String
  name        String
  description String?
  status      String   @default("draft")
  isDefault   Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  builderSteps BuilderStep[]
  assignments  StepCatalogAssignment[]
  compatibilityRules CompatibilityRule[]
  buildSessions BuildSession[]
  orderAttributions OrderAttribution[]

  @@index([shopId])
  @@index([shopId, isDefault])
  @@map("builders")
}

model BuilderStep {
  id        String  @id @default(cuid())
  shopId    String
  builderId String
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  name     String
  position Int
  enabled  Boolean @default(true)
  required Boolean @default(true)
  version  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments StepCatalogAssignment[]

  @@unique([builderId, position])
  @@index([shopId])
  @@index([builderId])
  @@map("builder_steps")
}

model StepCatalogAssignment {
  id     String @id @default(cuid())
  shopId String

  builderId String
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  stepId String
  step   BuilderStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  referenceType String

  shopifyCollectionId String?
  shopifyProductId    String?
  shopifyVariantId    String?

  position Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([builderId])
  @@index([stepId])
  @@map("step_catalog_assignments")
}

model SpecificationDefinition {
  id       String @id @default(cuid())
  shopId   String
  category String
  key      String
  label    String
  dataType String
  unit     String?
  required Boolean @default(false)
  config   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productSpecifications ProductSpecification[]

  @@unique([shopId, category, key])
  @@index([shopId])
  @@index([shopId, category])
  @@map("specification_definitions")
}

model ProductSpecification {
  id     String @id @default(cuid())
  shopId String

  shopifyProductId String
  shopifyVariantId String

  specificationDefinitionId String
  specificationDefinition   SpecificationDefinition @relation(fields: [specificationDefinitionId], references: [id], onDelete: Cascade)

  value    Json
  source   String  @default("manual")
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, shopifyVariantId, specificationDefinitionId])
  @@index([shopId])
  @@index([shopId, shopifyProductId])
  @@index([shopId, shopifyVariantId])
  @@index([specificationDefinitionId])
  @@map("product_specifications")
}

model CompatibilityRule {
  id        String  @id @default(cuid())
  shopId    String
  builderId String
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)

  sourceCategory String
  sourceField    String
  operator       String
  targetCategory String
  targetField    String
  comparisonValue Json?

  severity String  @default("error")
  enabled  Boolean @default(true)
  message  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([builderId])
  @@index([shopId, builderId])
  @@map("compatibility_rules")
}

model BuildSession {
  id String @id @default(cuid())
  publicSessionId String @unique
  shopId String
  builderId String
  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  status String @default("STARTED")
  currency String?
  buildValue Decimal?
  startedAt DateTime @default(now())
  validatedAt DateTime?
  cartAddedAt DateTime?
  completedAt DateTime?
  shopifyOrderId String?
  selections BuildSelection[]
  orderAttributions OrderAttribution[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId])
  @@index([shopId, builderId])
  @@map("build_sessions")
}

model BuildSelection {
  id String @id @default(cuid())
  buildSessionId String
  buildSession BuildSession @relation(fields: [buildSessionId], references: [id], onDelete: Cascade)
  stepId String
  shopifyProductId String
  shopifyVariantId String
  quantity Int @default(1)
  priceSnapshot Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([buildSessionId, stepId])
  @@index([shopifyVariantId])
  @@map("build_selections")
}

model OrderAttribution {
  id String @id @default(cuid())
  shopId String
  builderId String
  builder Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  buildSessionId String
  buildSession BuildSession @relation(fields: [buildSessionId], references: [id], onDelete: Cascade)
  shopifyOrderId String
  shopifyOrderName String?
  currency String?
  attributedValue Decimal?
  orderTotal Decimal?
  createdAt DateTime @default(now())
  @@unique([shopId, shopifyOrderId, buildSessionId])
  @@index([shopId])
  @@index([shopId, builderId])
  @@map("order_attributions")
}
